# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_MODEL_ID=claude-sonnet-4-6
LLM_MAX_TOKENS=4096

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# ─── Talent Source APIs ────────────────────────────────────────────────────────
GOOGLE_CSE_KEY=AIza...
GOOGLE_CSE_CX=0123456789abcdef0   # Custom Search Engine ID

NAUKRI_KEY=...

PDL_KEY=...                        # People Data Labs

# ─── Pipeline Behaviour ──────────────────────────────────────────────────────
# Set to "false" to hit real APIs (requires valid keys above)
MOCK_MODE=true

# ─── Security ────────────────────────────────────────────────────────────────
# API key for authenticating requests. Leave empty to disable auth.
APP_API_KEY=

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Max POST requests per minute per IP (0 = unlimited)
RATE_LIMIT_RPM=30

# ─── Pipeline Tuning ─────────────────────────────────────────────────────────
HITL_MIN_RAW=15
FORCE_ACCEPT_TOP_N=5
MIN_ACCEPTED=5
MAX_ITERATIONS=3
MIN_RAW_PER_ITER=10
HITL_TIMEOUT_SECONDS=300
NAME_OVERLAP_THRESHOLD=0.80
EVENT_BUS_MAX_SIZE=1000
